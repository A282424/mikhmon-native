<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MikhmonNative" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/mik_blue</item>
        <item name="colorPrimaryDark">@color/mik_bg_darker</item>
        <item name="colorAccent">@color/mik_highlight</item>
        <item name="android:windowBackground">@color/mik_bg</item>
        <item name="android:textColorPrimary">@color/mik_text</item>
        <item name="android:textColorSecondary">@color/mik_text_muted</item>
        <item name="colorControlNormal">@color/mik_text_muted</item>
        <item name="colorControlActivated">@color/mik_blue</item>
    </style>

    <style name="Theme.MikhmonNative.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/mik_border</item>
        <item name="hintTextColor">@color/mik_text_muted</item>
        <item name="android:textColorHint">@color/mik_text_muted</item>
        <item name="boxBackgroundColor">@color/mik_card_light</item>
    </style>

    <style name="Theme.MikhmonNative.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/mik_blue</item>
        <item name="android:textColor">@color/mik_text</item>
        <item name="cornerRadius">6dp</item>
    </style>
</resources>
